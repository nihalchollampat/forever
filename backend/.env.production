# Render.com Environment Variables
# Copy these values to Render Dashboard

# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/forever?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here

# JWT Secret - Generate a strong random string (at least 32 characters)
# You can generate one at: https://passwordsgenerator.net/
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# Server Configuration
PORT=10000
NODE_ENV=production

# Frontend URL - Your Vercel deployment
FRONTEND_URL=https://forever-pi-six.vercel.app

