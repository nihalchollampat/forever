# Frontend Environment Variables
# For Vercel deployment, these should be set in Vercel Dashboard

# Backend API URL - Update this after deploying backend to Render
VITE_API_URL=https://your-backend-service.onrender.com/api

# Backend Image URL - Update this after deploying backend to Render
# If deploying images separately, use CDN URL here
VITE_IMAGE_URL=https://your-backend-service.onrender.com/uploads

